# gateway：轻量 API 层（无 torch，镜像 ~300MB）
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

WORKDIR /app
COPY requirements-gateway.txt .
RUN pip install --no-cache-dir -r requirements-gateway.txt

COPY shared/ ./shared/
COPY gateway/ ./gateway/

# 非 root 运行
RUN useradd -r -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8700
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
  CMD python -c "import urllib.request;urllib.request.urlopen('http://localhost:8700/health',timeout=5)"

CMD ["uvicorn", "gateway.app:app", "--host", "0.0.0.0", "--port", "8700", "--workers", "2"]

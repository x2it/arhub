# ========= 镜像源（换源只改这里，不改编排）=========
# 以下为国内网络加速的可选配置，可按实际网络环境替换为官方源。
PG_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
PAPERLESS_IMAGE=ghcr.io/paperless-ngx/paperless-ngx:latest
PYTHON_IMAGE=python:3.11-slim

# ========= 数据库（启动期由 scripts/up.sh 首次生成随机口令并写入 .env）=========
POSTGRES_DB=archive
POSTGRES_USER=archive
POSTGRES_PASSWORD=CHANGE_ME_runtime_generated
PAPERLESS_DBNAME=archive
PAPERLESS_DBUSER=archive
PAPERLESS_DBPASS=CHANGE_ME_runtime_generated

# ========= Paperless 主干 =========
PAPERLESS_URL=http://webserver:8000
PAPERLESS_SECRET_KEY=CHANGE_ME_runtime_generated
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=CHANGE_ME_runtime_generated
PAPERLESS_ADMIN_EMAIL=admin@archive.local

# ========= 自研服务 =========
GATEWAY_PORT=8700
JWT_SECRET=CHANGE_ME_runtime_generated
INTERNAL_TOKEN=CHANGE_ME_runtime_generated
CORS_ORIGINS=
MAX_UPLOAD_MB=100
RATE_LIMIT_PER_MIN=600
VECTOR_BACKEND=pg
TENANT_ID=default

# ========= 模型（已缓存本地，强制离线加载）=========
HF_HUB_OFFLINE=1
HF_ENDPOINT=https://hf-mirror.com
EMBED_MODEL=BAAI/bge-small-zh-v1.5
